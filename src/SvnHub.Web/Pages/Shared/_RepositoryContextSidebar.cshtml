@model SvnHub.Web.Support.RepositoryContextSidebarModel

@if (Model.HasContent)
{
    <aside class="repo-context-sidebar">
        @if (Model.Labels.Count > 0)
        {
            <section class="repo-context-section">
                <div class="repo-context-title">Repository labels</div>
                <div class="repo-labels d-flex flex-wrap gap-1">
                    @foreach (var label in Model.Labels)
                    {
                        <a class="badge rounded-pill text-bg-secondary text-decoration-none"
                           asp-page="/Repos/Index"
                           asp-route-label="@label">@label</a>
                    }
                </div>
            </section>
        }
        @if (Model.IncomingReferenceCount > 0)
        {
            <section class="repo-context-section @(Model.Labels.Count > 0 ? "mt-3" : null)">
                <div class="repo-context-title">External references</div>
                <a class="text-decoration-none"
                   asp-page="/Repos/ExternalReferences"
                   asp-route-repoName="@Model.RepositoryName">
                    <span class="d-block">
                        @Model.IncomingRepositoryCount @(Model.IncomingRepositoryCount == 1 ? "repository" : "repositories")
                    </span>
                    <span class="d-block small text-body-secondary">
                        @Model.IncomingReferenceCount @(Model.IncomingReferenceCount == 1 ? "reference" : "references")
                    </span>
                </a>
            </section>
        }
    </aside>
}
