@using SvnHub.App.Services
@inject SettingsService Settings
@inject BrandingService Branding
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SvnHub</title>
    <link rel="icon" href="@Url.Content($"~/branding/favicon?v={Branding.GetFaviconVersion()}")" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SvnHub.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/code.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/highlightjs/styles/github-dark.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-body-tertiary border-bottom mb-3">
        <div class="container">
            @{
                var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
                var brandPage = isAuthenticated ? "/Repos/Index" : "/Index";
                var organizationName = Settings.GetOrganizationName();
            }
            <a class="navbar-brand d-inline-flex align-items-baseline gap-2" asp-area="" asp-page="@brandPage">
                <span>SvnHub</span>
                @if (!string.IsNullOrWhiteSpace(organizationName))
                {
                    <span class="navbar-brand-separator" aria-hidden="true">|</span>
                    <span class="navbar-organization">@organizationName</span>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Repos/Index">Repos</a>
                        </li>
                    }
                    @if (User?.IsInRole("AdminUsers") ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Admin/Users">Users</a>
                        </li>
                    }
                    @if (User?.IsInRole("AdminSystem") ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Admin/Settings">Settings</a>
                        </li>
                    }
                    @if (User?.IsInRole("AdminRepo") ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Admin/Groups">Groups</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="accountMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                @User.Identity!.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Account">Account</a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page="/Logout">
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - SvnHub
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/highlightjs/highlight.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
