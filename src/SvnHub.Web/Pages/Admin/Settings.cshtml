@page
@model SvnHub.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Server settings</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Success))
{
    <div class="alert alert-success">@Model.Success</div>
}

<form method="post" class="mt-3" autocomplete="off">
    <h2 class="h5 mb-3">Branding</h2>

    <div class="mb-3">
        <label asp-for="Input.OrganizationName" class="form-label"></label>
        <input asp-for="Input.OrganizationName" class="form-control" maxlength="80" placeholder="Acme Engineering" />
        <div class="form-text">Shown next to the SvnHub brand in the top navigation.</div>
        <span asp-validation-for="Input.OrganizationName" class="text-danger"></span>
    </div>

    <h2 class="h5 mt-4 mb-3">Repositories</h2>

    <div class="mb-3">
        <label asp-for="Input.RepositoriesRootPath" class="form-label"></label>
        <input asp-for="Input.RepositoriesRootPath" class="form-control" />
        <div class="form-text">Used when creating and synchronizing repositories. Registrations outside a newly selected root are preserved as missing until reviewed; run <a asp-page="/Repos/Index">Synchronize</a> from the repository list.</div>
        <span asp-validation-for="Input.RepositoriesRootPath" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.SvnBaseUrl" class="form-label"></label>
        <input asp-for="Input.SvnBaseUrl" class="form-control" placeholder="https://svn.example.com/svn" />
        <div class="form-text">Used to build checkout and "Copy SVN URL" links. Leave empty to disable these links. A local F5 run does not host the SVN HTTP/DAV endpoint.</div>
        <span asp-validation-for="Input.SvnBaseUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.SvnBaseUrlAliases" class="form-label"></label>
        <textarea asp-for="Input.SvnBaseUrlAliases" class="form-control" rows="3" placeholder="https://old-svn.example.com:18080/svn"></textarea>
        <div class="form-text">Legacy SVN base URLs treated as internal when resolving <code>svn:externals</code>. Use one URL per line.</div>
        <span asp-validation-for="Input.SvnBaseUrlAliases" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.MaxUploadMegabytes" class="form-label"></label>
        <input asp-for="Input.MaxUploadMegabytes" type="number" min="1" max="2048" class="form-control" />
        <div class="form-text">Maximum allowed upload size for the web UI (affects Upload).</div>
        <span asp-validation-for="Input.MaxUploadMegabytes" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Input.CreateIfMissing" class="form-check-input" />
        <label asp-for="Input.CreateIfMissing" class="form-check-label"></label>
    </div>

    <h2 class="h5 mt-4 mb-3">Repository index</h2>

    <div class="form-check mb-3">
        <input asp-for="Input.IndexingEnabled" class="form-check-input" />
        <label asp-for="Input.IndexingEnabled" class="form-check-label"></label>
        <div class="form-text">Periodically updates the SQLite index. Manual Scan now and index-backed search can still use the index when this is off.</div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.IndexingScanIntervalSeconds" class="form-label"></label>
            <input asp-for="Input.IndexingScanIntervalSeconds" type="number" min="30" max="86400" class="form-control" />
            <div class="form-text">How often the background worker checks repositories.</div>
            <span asp-validation-for="Input.IndexingScanIntervalSeconds" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.IndexingMaxRevisionsPerRepositoryPerScan" class="form-label"></label>
            <input asp-for="Input.IndexingMaxRevisionsPerRepositoryPerScan" type="number" min="0" max="10000" class="form-control" />
            <div class="form-text">One pass indexes at most this many revisions per repository. Use 0 for unlimited.</div>
            <span asp-validation-for="Input.IndexingMaxRevisionsPerRepositoryPerScan" class="text-danger"></span>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
</form>

<hr class="my-4" />

<section id="index-status"
         data-status-url="@Url.Page("/Admin/Settings", "IndexStatus")"
         aria-labelledby="index-status-heading">
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 id="index-status-heading" class="h5 mb-1">Index status</h2>
            <div id="index-database-path" class="text-muted small">@Model.IndexStatus?.Store.DatabasePath</div>
        </div>
        <form method="post" asp-page-handler="ScanIndexNow">
            <button id="index-scan-button"
                    class="btn btn-outline-primary"
                    type="submit"
                    disabled="@(Model.IndexStatus?.IsRunning == true)">Scan now</button>
        </form>
    </div>

    @if (Model.IndexStatus is not null)
    {
        <dl class="row small mb-3">
            <dt class="col-sm-3">Background worker</dt>
            <dd id="index-worker-state" class="col-sm-9">
                @(Model.IndexStatus.IsRunning
                    ? (string.IsNullOrWhiteSpace(Model.IndexStatus.CurrentRepository) ? "Running" : $"Running ({Model.IndexStatus.CurrentRepository})")
                    : (Model.IndexStatus.Settings.Enabled ? "Automatic scan enabled" : "Manual only"))
            </dd>

            <dt id="index-run-progress-label"
                class="col-sm-3 @(Model.IndexStatus.IsRunning && Model.IndexStatus.CurrentRunTotalRepositories > 0 ? "" : "d-none")">
                Scan progress
            </dt>
            <dd id="index-run-progress"
                class="col-sm-9 @(Model.IndexStatus.IsRunning && Model.IndexStatus.CurrentRunTotalRepositories > 0 ? "" : "d-none")">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span id="index-run-progress-text">
                        @Model.IndexStatus.CurrentRunProcessedRepositories / @Model.IndexStatus.CurrentRunTotalRepositories repositories
                    </span>
                    <span id="index-run-progress-remaining" class="text-muted">
                        @Model.IndexStatus.CurrentRunRemainingRepositories remaining
                    </span>
                </div>
                <div class="progress mt-1 sp-progress-thin">
                    <div id="index-run-progress-bar"
                         class="progress-bar"
                         role="progressbar"
                         style="width: @(Model.RunRepositoryProgressPercent)%"
                         aria-valuenow="@Model.RunRepositoryProgressPercent"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
            </dd>

            <dt id="index-current-repo-progress-label"
                class="col-sm-3 @(Model.IndexStatus.IsRunning && Model.IndexStatus.CurrentRepositoryTotalRevisions > 0 ? "" : "d-none")">
                Current repository
            </dt>
            <dd id="index-current-repo-progress"
                class="col-sm-9 @(Model.IndexStatus.IsRunning && Model.IndexStatus.CurrentRepositoryTotalRevisions > 0 ? "" : "d-none")">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span id="index-current-repo-progress-text">
                        @Model.IndexStatus.CurrentRepositoryProcessedRevisions / @Model.IndexStatus.CurrentRepositoryTotalRevisions revisions
                    </span>
                    <span id="index-current-repo-progress-detail" class="text-muted">
                        r@(Model.IndexStatus.CurrentRepositoryCurrentRevision) of r@(Model.IndexStatus.CurrentRepositoryTargetRevision)
                    </span>
                </div>
                <div class="progress mt-1 sp-progress-thin">
                    <div id="index-current-repo-progress-bar"
                         class="progress-bar"
                         role="progressbar"
                         style="width: @(Model.CurrentRepositoryProgressPercent)%"
                         aria-valuenow="@Model.CurrentRepositoryProgressPercent"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
            </dd>

            <dt class="col-sm-3">Last run</dt>
            <dd id="index-last-run" class="col-sm-9">@SettingsModel.FormatDate(Model.IndexStatus.LastRunCompletedAt)</dd>

            <dt class="col-sm-3">Summary</dt>
            <dd id="index-summary" class="col-sm-9">@(Model.IndexStatus.LastRunSummary ?? "-")</dd>

            <dt class="col-sm-3">Indexed data</dt>
            <dd id="index-indexed-data" class="col-sm-9">
                @Model.IndexStatus.Store.RepositoryCount repositories,
                @Model.IndexStatus.Store.RevisionCount revisions,
                @Model.IndexStatus.Store.ChangedPathCount changed paths,
                @Model.IndexStatus.Store.HeadTreeEntryCount head tree entries,
                @Model.IndexStatus.Store.HeadPropertyCount head properties,
                @Model.IndexStatus.Store.HeadExternalCount externals
            </dd>

            <dt class="col-sm-3">Remaining</dt>
            <dd id="index-remaining" class="col-sm-9">
                @Model.LiveIndexRemainingRevisions revisions
                @if (Model.IndexPendingRepositoryCount > 0)
                {
                    <span class="text-muted">in @Model.IndexPendingRepositoryCount repositories</span>
                }
            </dd>
        </dl>

        <div id="index-last-error"
             class="alert alert-warning small @(string.IsNullOrWhiteSpace(Model.IndexStatus.LastRunError) ? "d-none" : "")">
            @Model.IndexStatus.LastRunError
        </div>

        <div id="index-repository-table" class="table-responsive @(Model.IndexRepositoryRows.Count == 0 ? "d-none" : "")">
                <table class="table table-sm align-middle">
                    <thead>
                    <tr>
                        <th>Repository</th>
                        <th>Indexed</th>
                        <th>Head</th>
                        <th>Remaining</th>
                        <th>Last success</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody id="index-repository-rows">
                    @foreach (var row in Model.IndexRepositoryRows)
                    {
                        <tr>
                            <td>@row.RepositoryName</td>
                            <td>r@(row.IndexedRevision)</td>
                            <td>r@(row.YoungestRevision)</td>
                            <td>@SettingsModel.GetRemainingRevisions(row)</td>
                            <td>@SettingsModel.FormatDate(row.LastSuccessAt)</td>
                            <td>
                                <span class="badge @SettingsModel.GetIndexRowBadgeClass(row)">@SettingsModel.GetIndexRowStatus(row)</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        <div id="index-hidden-repositories"
             class="text-muted small @(Model.IndexHiddenRepositoryCount == 0 ? "d-none" : "")">
            Showing repositories needing attention first; <span id="index-hidden-count">@Model.IndexHiddenRepositoryCount</span> more are hidden.
        </div>
    }
</section>

<hr class="my-4" />

<section aria-labelledby="site-icon-heading">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h2 id="site-icon-heading" class="h5 mb-1">Site icon</h2>
            <div class="text-muted small">PNG or ICO, max @Model.MaxFaviconKilobytes KB.</div>
        </div>
        <img class="settings-favicon-preview"
             src="@Url.Content(Model.FaviconHref)"
             alt=""
             width="32"
             height="32" />
    </div>

    <form method="post"
          asp-page-handler="UploadFavicon"
          enctype="multipart/form-data"
          class="d-flex flex-wrap align-items-end gap-2">
        <div class="flex-grow-1">
            <label asp-for="FaviconFile" class="form-label">Icon file</label>
            <input asp-for="FaviconFile"
                   type="file"
                   class="form-control"
                   accept=".png,.ico,image/png,image/x-icon,image/vnd.microsoft.icon" />
        </div>
        <button class="btn btn-primary ms-sm-auto" type="submit">Upload</button>
    </form>

    @if (Model.HasCustomFavicon)
    {
        <form method="post" asp-page-handler="ResetFavicon" class="d-flex justify-content-end mt-2">
            <button class="btn btn-outline-secondary" type="submit">Reset to default</button>
        </form>
    }
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const root = document.getElementById('index-status');
            if (!root) return;

            const statusUrl = root.dataset.statusUrl;
            const scanButton = document.getElementById('index-scan-button');
            const rowsBody = document.getElementById('index-repository-rows');
            const table = document.getElementById('index-repository-table');
            const hiddenNote = document.getElementById('index-hidden-repositories');
            const hiddenCount = document.getElementById('index-hidden-count');
            let timerId = 0;
            let inFlight = false;

            const setText = (id, value) => {
                const element = document.getElementById(id);
                if (element) element.textContent = value ?? '';
            };

            const setHidden = (element, hidden) => {
                if (!element) return;
                element.classList.toggle('d-none', hidden);
            };

            const setProgressBar = (id, percent) => {
                const element = document.getElementById(id);
                if (!element) return;
                const normalized = Math.max(0, Math.min(100, Number(percent) || 0));
                element.style.width = `${normalized}%`;
                element.setAttribute('aria-valuenow', normalized.toString());
            };

            const appendCell = (row, value) => {
                const cell = document.createElement('td');
                cell.textContent = value ?? '';
                row.appendChild(cell);
            };

            const renderRows = rows => {
                if (!rowsBody || !table) return;
                rowsBody.replaceChildren();

                for (const item of rows ?? []) {
                    const row = document.createElement('tr');
                    appendCell(row, item.repositoryName);
                    appendCell(row, `r${item.indexedRevision}`);
                    appendCell(row, `r${item.youngestRevision}`);
                    appendCell(row, item.remaining);
                    appendCell(row, item.lastSuccess);

                    const statusCell = document.createElement('td');
                    const badge = document.createElement('span');
                    badge.className = `badge ${item.statusClass || 'text-bg-secondary'}`;
                    badge.textContent = item.status || '';
                    statusCell.appendChild(badge);
                    row.appendChild(statusCell);

                    rowsBody.appendChild(row);
                }

                setHidden(table, rowsBody.children.length === 0);
            };

            const applyStatus = data => {
                if (!data?.available) return;

                setText('index-worker-state', data.workerState);
                setText('index-last-run', data.lastRun);
                setText('index-summary', data.summary);
                setText('index-indexed-data', data.indexedData);
                setText('index-remaining', data.remaining);

                if (scanButton) scanButton.disabled = data.isRunning === true;

                setHidden(document.getElementById('index-run-progress-label'), !data.runProgressVisible);
                setHidden(document.getElementById('index-run-progress'), !data.runProgressVisible);
                setText('index-run-progress-text', data.runProgressText);
                setText('index-run-progress-remaining', data.runProgressRemaining);
                setProgressBar('index-run-progress-bar', data.runProgressPercent);

                setHidden(document.getElementById('index-current-repo-progress-label'), !data.currentRepositoryProgressVisible);
                setHidden(document.getElementById('index-current-repo-progress'), !data.currentRepositoryProgressVisible);
                setText('index-current-repo-progress-text', data.currentRepositoryProgressText);
                setText('index-current-repo-progress-detail', data.currentRepositoryProgressDetail);
                setProgressBar('index-current-repo-progress-bar', data.currentRepositoryProgressPercent);

                const error = document.getElementById('index-last-error');
                if (error) {
                    error.textContent = data.lastRunError || '';
                    setHidden(error, !data.lastRunError);
                }

                renderRows(data.rows);

                if (hiddenCount) hiddenCount.textContent = data.hiddenRepositoryCount ?? 0;
                setHidden(hiddenNote, !data.hiddenRepositoryCount);
            };

            const schedule = isRunning => {
                window.clearTimeout(timerId);
                timerId = window.setTimeout(refresh, isRunning ? 2000 : 15000);
            };

            const refresh = async () => {
                if (document.hidden) {
                    schedule(false);
                    return;
                }

                if (inFlight) return;
                inFlight = true;
                try {
                    const response = await fetch(statusUrl, {
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store',
                    });
                    if (!response.ok) return;

                    const data = await response.json();
                    applyStatus(data);
                    schedule(data.isRunning === true);
                } catch {
                    schedule(false);
                } finally {
                    inFlight = false;
                }
            };

            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) refresh();
            });

            schedule(@((Model.IndexStatus?.IsRunning == true).ToString().ToLowerInvariant()));
        })();
    </script>
}
