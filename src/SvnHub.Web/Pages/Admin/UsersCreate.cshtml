@page "/admin/users/create"
@model SvnHub.Web.Pages.Admin.UsersCreateModel
@{
    ViewData["Title"] = "Create user";
}

<h1>Create user</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

<form method="post" class="mt-3" autocomplete="off">
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.UserName" class="form-label"></label>
            <input asp-for="Input.UserName" class="form-control" />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" type="password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Repository grants</label>
            <div class="d-flex flex-wrap gap-3">
                @if (Model.CanAssignRepoRead)
                {
                    <div class="form-check">
                        <input asp-for="Input.RepoRead" class="form-check-input" />
                        <label asp-for="Input.RepoRead" class="form-check-label"></label>
                    </div>
                }
                @if (Model.CanAssignRepoWrite)
                {
                    <div class="form-check">
                        <input asp-for="Input.RepoWrite" class="form-check-input" />
                        <label asp-for="Input.RepoWrite" class="form-check-label"></label>
                    </div>
                }
                @if (Model.CanAssignRepoAdmin)
                {
                    <div class="form-check">
                        <input asp-for="Input.RepoAdmin" class="form-check-input" />
                        <label asp-for="Input.RepoAdmin" class="form-check-label"></label>
                    </div>
                }
                @if (Model.CanAssignRepoCreate)
                {
                    <div class="form-check">
                        <input asp-for="Input.RepoCreate" class="form-check-input" />
                        <label asp-for="Input.RepoCreate" class="form-check-label"></label>
                    </div>
                }
            </div>
            <div class="form-text">You can delegate only repository grants that you hold yourself.</div>
            @if (Model.CanAssignAdministrativeRoles)
            {
                <label class="form-label mt-3">Administrative roles</label>
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                        <input asp-for="Input.Owner" class="form-check-input" />
                        <label asp-for="Input.Owner" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.AdminUsers" class="form-check-input" />
                        <label asp-for="Input.AdminUsers" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.AdminSystem" class="form-check-input" />
                        <label asp-for="Input.AdminSystem" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.RepoHooks" class="form-check-input" />
                        <label asp-for="Input.RepoHooks" class="form-check-label"></label>
                    </div>
                </div>
                <div class="form-text">Only Owners can assign administrative roles and repo.hooks.</div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Users">Cancel</a>
        <button class="btn btn-primary" type="submit">Create</button>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
