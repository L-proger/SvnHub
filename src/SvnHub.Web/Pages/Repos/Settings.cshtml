@page "/repos/{repoName}/settings"
@model SvnHub.Web.Pages.Repos.SettingsModel
@{
    ViewData["Title"] = $"{Model.RepoName} settings";
}

<h1>@Model.RepoName</h1>
<div class="text-muted">Repository settings</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Success))
{
    <div class="alert alert-success mt-3">@Model.Success</div>
}

<div class="mt-3">
    <a asp-page="/Repos/Index">Back to Repositories</a>
</div>

<hr class="mt-4" />

@if (Model.CanAdministerRepository)
{
    <h2>Rename</h2>
    <form method="post" asp-page-handler="Rename" class="mt-2" autocomplete="off">
        <div class="mb-2">
            <label asp-for="RenameInput.NewName" class="form-label"></label>
            <div class="input-group">
                <input asp-for="RenameInput.NewName" class="form-control" />
                <button class="btn btn-primary" type="submit">Rename</button>
            </div>
            <span asp-validation-for="RenameInput.NewName" class="text-danger"></span>
            <div class="form-text">Allowed: letters (upper/lower), digits, dot, dash, underscore.</div>
        </div>
    </form>

    <hr class="mt-4" />

    <h2>Labels</h2>
    <form method="post" asp-page-handler="Labels" class="mt-2" autocomplete="off">
        <div class="mb-2">
            <label asp-for="LabelsInput.Labels" class="form-label"></label>
            <div class="d-flex gap-2 align-items-start">
                <div class="label-editor flex-grow-1"
                     data-label-editor
                     data-label-editor-suggestions="@System.Text.Json.JsonSerializer.Serialize(Model.LabelSuggestions)">
                    <input asp-for="LabelsInput.Labels" type="hidden" data-label-editor-value />
                    <div class="label-editor-control" data-label-editor-control>
                        <div class="label-editor-tokens" data-label-editor-tokens></div>
                        <input class="label-editor-input"
                               type="text"
                               data-label-editor-input
                               placeholder="Add label"
                               role="combobox"
                               aria-expanded="false"
                               aria-label="Add label" />
                    </div>
                    <div class="label-editor-suggestions" data-label-editor-suggestions-list hidden></div>
                    <div class="form-text label-editor-error" data-label-editor-error></div>
                </div>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
            <span asp-validation-for="LabelsInput.Labels" class="text-danger"></span>
            <div class="form-text">Press Enter or comma to add a label. Labels are used for repository grouping and filtering.</div>
        </div>
    </form>
}

@if (Model.CanAdminRepository)
{
    <hr class="mt-4" />

    <h2>Repository administrators</h2>
    <div class="form-text mb-2">
        Repository administrators can change repository settings, rename/delete the repository, and manage SVN access rules. This does not grant SVN read/write by itself.
    </div>

    <form method="post"
          asp-page-handler="InheritedGrants"
          class="mb-3"
          onsubmit="return document.getElementById('include-inherited-management-grants')?.checked !== false || !this.dataset.warnSelfRemoval || confirm(this.dataset.warnSelfRemoval);"
          data-warn-self-removal="@(Model.DisablingInheritedManagementGrantsRemovesYourAdminAccess ? "Disabling inherited repository management grants will remove your repository Admin access after this save. An Owner can restore access later. Continue?" : null)">
        <input type="hidden" asp-for="InheritedGrantsInput.IncludeInheritedContentGrants" />
        <div class="form-check">
            <input asp-for="InheritedGrantsInput.IncludeInheritedManagementGrants"
                   id="include-inherited-management-grants"
                   class="form-check-input" />
            <label asp-for="InheritedGrantsInput.IncludeInheritedManagementGrants" class="form-check-label"></label>
        </div>
        <div class="form-text">
            When enabled, users with global <code>repo.admin</code> inherit repository Admin here.
        </div>
        <button class="btn btn-primary btn-sm mt-2" type="submit">Save administrator inheritance</button>
    </form>

    <h3 class="h6 mt-4">Explicit repository administrators</h3>
    @if (Model.ManagementGrants.Count > 0)
    {
        <table class="table table-sm mt-2">
            <thead>
            <tr>
                <th>Subject</th>
                <th>Access</th>
                <th>Created</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var grant in Model.ManagementGrants)
            {
                <tr>
                    <td>@grant.SubjectDisplay</td>
                    <td>@grant.RoleDisplay</td>
                    <td>@grant.CreatedAt.ToString("u")</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="DeleteManagementGrant" class="d-inline">
                            <input type="hidden" name="grantId" value="@grant.Id" />
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return !this.dataset.warnSelfRemoval || confirm(this.dataset.warnSelfRemoval);"
                                    data-warn-self-removal="@(grant.DeletingRemovesYourAdminAccess ? "Deleting this grant will remove your repository Admin access. An Owner can restore access later. Continue?" : null)">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-muted">No explicit repository administrators yet.</div>
    }

    <h3 class="mt-4">Add repository administrator</h3>
    <form method="post" asp-page-handler="AddManagementGrant" class="mt-2" autocomplete="off">
        <div class="row">
            <div class="col-md-2 mb-3">
                <label asp-for="ManagementGrantInput.SubjectType" class="form-label"></label>
                <select asp-for="ManagementGrantInput.SubjectType" class="form-select">
                    <option value="User">User</option>
                    <option value="Group">Group</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">User</label>
                <select asp-for="ManagementGrantInput.UserId" class="form-select">
                    @foreach (var u in Model.UserOptions)
                    {
                        <option value="@u.Id">@u.UserName</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Group</label>
                <select asp-for="ManagementGrantInput.GroupId" class="form-select">
                    @foreach (var g in Model.GroupOptions)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">Add</button>
            </div>
        </div>
        <div class="form-text">
            Adds repository Admin for the selected user or group. Use SVN content rules below for read/write access.
        </div>
    </form>

    <hr class="mt-4" />

    <h2>SVN content access</h2>
    <form method="post" asp-page-handler="InheritedGrants" class="mb-3">
        <input type="hidden" asp-for="InheritedGrantsInput.IncludeInheritedManagementGrants" />
        <div class="form-check">
            <input asp-for="InheritedGrantsInput.IncludeInheritedContentGrants"
                   id="include-inherited-content-grants"
                   class="form-check-input" />
            <label asp-for="InheritedGrantsInput.IncludeInheritedContentGrants" class="form-check-label"></label>
        </div>
        <div class="form-text">
            When enabled, global <code>repo.read</code> and <code>repo.write</code> grants apply before explicit path rules.
        </div>
        <button class="btn btn-primary btn-sm mt-2" type="submit">Save content inheritance</button>
    </form>

    @if (!Model.IncludeInheritedContentGrants)
    {
        <div class="alert alert-info">
            Inherited <code>repo.read</code> and <code>repo.write</code> grants are disabled here. Only users/groups listed below have SVN access.
            Rules are applied top-to-bottom; the last matching rule wins and can override group access.
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Users inherit SVN access from their global <code>repo.read</code> and <code>repo.write</code> grants.
            Rules are applied top-to-bottom; the last matching rule wins and can override group access.
        </div>
    }

    @if (Model.AccessRules.Count > 0)
    {
        <table class="table table-sm mt-2">
        <thead>
        <tr>
            <th>Order</th>
            <th>Path</th>
            <th>Subject</th>
            <th>Access</th>
            <th>Created</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.AccessRules)
        {
            <tr>
                <td>@r.Order</td>
                <td><code>@r.Path</code></td>
                <td>@r.SubjectDisplay</td>
                <td>@r.Access</td>
                <td>@r.CreatedAt.ToString("u")</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="MoveAccessRule" class="d-inline">
                        <input type="hidden" name="ruleId" value="@r.Id" />
                        <input type="hidden" name="direction" value="up" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(!r.CanMoveUp)">Up</button>
                    </form>
                    <form method="post" asp-page-handler="MoveAccessRule" class="d-inline">
                        <input type="hidden" name="ruleId" value="@r.Id" />
                        <input type="hidden" name="direction" value="down" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(!r.CanMoveDown)">Down</button>
                    </form>
                    <form method="post" asp-page-handler="DeleteAccessRule" class="d-inline">
                        <input type="hidden" name="ruleId" value="@r.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    }
    else if (!Model.IncludeInheritedContentGrants)
    {
        <div class="text-muted">No rules yet. Add at least one rule to allow access.</div>
    }
    else
    {
        <div class="text-muted">No rules yet.</div>
    }

    <h3 class="mt-4">Add rule</h3>
    <form method="post" asp-page-handler="AddAccessRule" class="mt-2" autocomplete="off">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="AccessRuleInput.Path" class="form-label"></label>
                <input asp-for="AccessRuleInput.Path" class="form-control" placeholder="/" />
                <span asp-validation-for="AccessRuleInput.Path" class="text-danger"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="AccessRuleInput.SubjectType" class="form-label"></label>
                <select asp-for="AccessRuleInput.SubjectType" class="form-select">
                    <option value="User">User</option>
                    <option value="Group">Group</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">User</label>
                <select asp-for="AccessRuleInput.UserId" class="form-select">
                    @foreach (var u in Model.UserOptions)
                    {
                        <option value="@u.Id">@u.UserName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 mb-3">
                <label class="form-label">Group</label>
                <select asp-for="AccessRuleInput.GroupId" class="form-select">
                    @foreach (var g in Model.GroupOptions)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="AccessRuleInput.Access" class="form-label"></label>
                <select asp-for="AccessRuleInput.Access" class="form-select">
                    <option value="None">None (deny)</option>
                    <option value="Read">Read</option>
                    <option value="Write">Write</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Add</button>
        </div>
    </form>

    <hr class="mt-4" />

    <h2>Delete</h2>
    <div class="alert alert-warning">
        Delete moves the repository folder into a <code>.deleted</code> folder and hides it from the UI.
        This is not a permanent wipe.
    </div>

    <form method="post" asp-page-handler="Delete" class="mt-2" autocomplete="off">
        <div class="mb-3">
            <label asp-for="DeleteInput.ConfirmName" class="form-label"></label>
            <input asp-for="DeleteInput.ConfirmName" class="form-control" />
            <span asp-validation-for="DeleteInput.ConfirmName" class="text-danger"></span>
            <div class="form-text">Type <code>@Model.RepoName</code> to confirm.</div>
        </div>

        <button class="btn btn-danger" type="submit">Delete repository</button>
    </form>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
