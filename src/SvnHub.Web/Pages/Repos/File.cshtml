@page "/repos/{repoName}/file/{**path}"
@model SvnHub.Web.Pages.Repos.FileModel
@{
    ViewData["Title"] = $"{Model.RepoName} - {Model.Path}";
    var lineCount = !Model.IsImage &&
        !Model.IsPdf &&
        !Model.IsGerberPreview &&
        !Model.IsModelPreview &&
        !Model.IsAltiumPreview &&
        !Model.IsMarkdown
            ? Model.LineCount
            : null;

    var fileActions = new List<RepositoryObjectActionModel>();
    if (Model.CanEdit)
    {
        fileActions.Add(new RepositoryObjectActionModel(
            "Delete",
            ButtonClass: "btn-outline-danger",
            FormAction: Url.Page("/Repos/File", "Delete", new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.Path) }),
            Confirm: "Delete this file from SVN? This will create a new revision.",
            HiddenFields: new Dictionary<string, string?> { ["path"] = Model.Path }));

        fileActions.Add(new RepositoryObjectActionModel(
            "Edit",
            Href: Url.Page("/Repos/Edit", null, new { repoName = Model.RepoName, path = Model.Path })));
    }

    if (Model.CanServeFile)
    {
        fileActions.Add(new RepositoryObjectActionModel(
            "Raw",
            Href: Url.Page("/Repos/Raw", null, new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.Path), rev = Model.ViewRevision }),
            OpenInNewTab: true));
        fileActions.Add(new RepositoryObjectActionModel(
            "Download",
            Href: Url.Page("/Repos/File", "Download", new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.Path), rev = Model.ViewRevision })));
    }

    fileActions.Add(new RepositoryObjectActionModel(
        "History",
        Href: Url.Page("/Repos/History", null, new { repoName = Model.RepoName, path = Model.Path, rev = Model.ViewRevision })));

    if (Model.CanCopyContent)
    {
        fileActions.Add(new RepositoryObjectActionModel("Copy content", CopyFrom: "#copySrc", CopyMessageTarget: "#copyMsg"));
    }

    if (!string.IsNullOrWhiteSpace(Model.CheckoutUrl))
    {
        fileActions.Add(new RepositoryObjectActionModel("Copy SVN URL", CopyText: Model.CheckoutUrl, CopyMessageTarget: "#copyMsg"));
    }
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h1 class="mb-0">@Model.RepoName</h1>
    @if (Model.CanOpenSettings)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Repos/Settings" asp-route-repoName="@Model.RepoName">Settings</a>
    }
</div>
<div class="text-muted">r@(Model.Revision)</div>

@await Html.PartialAsync("Shared/_RepositoryBreadcrumb", new RepositoryBreadcrumbModel(Model.RepoName, Model.Path, Model.ViewRevision))

@if (Model.ViewRevision is not null && Model.Revision != Model.HeadRevision)
{
    @await Html.PartialAsync("Shared/_RepositoryRevisionNotice", new RepositoryRevisionNoticeModel(Model.RepoName, Model.Revision, Model.HeadRevision))
}

@if (!string.IsNullOrWhiteSpace(Model.FlashError))
{
    <div class="alert alert-danger mt-3">@Model.FlashError</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}
else
{
    <div class="repo-object-layout mt-3 @(Model.Labels.Count > 0 ? "has-context" : "")">
        <div class="repo-object-main">
            @await Html.PartialAsync("Shared/_RepositoryObjectCard", new RepositoryObjectCardModel(
                new FilePreviewTitleModel(Model.Path, Model.FileSizeLabel, lineCount).ToRepositoryObjectTitle(),
                fileActions,
                "Shared/_RepositoryFilePreviewBody",
                Model,
                WrapBodyInCardBody: true,
                CopyMessageElementId: "copyMsg"))

            @if (Model.IsTruncated)
            {
                <div class="text-muted mt-2">Output truncated.</div>
            }
        </div>
        @await Html.PartialAsync("Shared/_RepositoryContextSidebar", new RepositoryContextSidebarModel(Model.Labels))
    </div>
}

@if (Model.CanCopyContent)
{
    <textarea id="copySrc" class="sp-copy-source">@Model.Contents</textarea>
}

@section Head
{
    @if (Model.IsMarkdown)
    {
        <link rel="stylesheet" href="~/css/markdown.css" asp-append-version="true" />
    }
}

@section Scripts
{
    @* copy handlers live in wwwroot/js/site.js *@
    @if (Model.IsGerberPreview)
    {
        <script src="~/lib/tracespace/pcb-stackup.min.js" asp-append-version="true"></script>
        <script src="~/js/gerber-preview.js" asp-append-version="true"></script>
    }
    @if (Model.IsModelPreview)
    {
        <script src="~/lib/online-3d-viewer/o3dv.min.js" asp-append-version="true"></script>
        <script src="~/js/model-preview.js" asp-append-version="true"></script>
    }
    @if (Model.IsAltiumPreview)
    {
        <script src="~/js/altium-preview.js" asp-append-version="true"></script>
    }
}
