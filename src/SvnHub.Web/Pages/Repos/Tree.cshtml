@page "/repos/{repoName}/tree/{**path}"
@model SvnHub.Web.Pages.Repos.TreeModel
@{
    ViewData["Title"] = $"{Model.RepoName} - {Model.Path}";
    var treeTitleMetadata = new List<string>
    {
        $"{Model.DirectoryCount} {(Model.DirectoryCount == 1 ? "folder" : "folders")}",
        $"{Model.FileCount} {(Model.FileCount == 1 ? "file" : "files")}",
    };

    if (Model.ExternalCount > 0)
    {
        treeTitleMetadata.Add($"{Model.ExternalCount} {(Model.ExternalCount == 1 ? "external" : "externals")}");
    }

    var checkoutUrl = Model.GetCheckoutUrl(Model.Path);
    var tortoiseCheckoutUrl = TortoiseSvnCommandUrl.BuildCheckoutUrl(checkoutUrl);
    var treeActions = new List<RepositoryObjectActionModel>();
    if (Model.CanWriteActions && Model.Path != "/")
    {
        treeActions.Add(new RepositoryObjectActionModel(
            "Delete",
            ButtonClass: "btn-outline-danger",
            FormAction: Url.Page("/Repos/Tree", "DeleteEntry", new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.ParentPath) }),
            Confirm: "Delete this folder from SVN? This will create a new revision.",
            RequiresCommitMessage: true,
            HiddenFields: new Dictionary<string, string?> { ["targetPath"] = Model.Path }));
    }

    if (Model.CanWriteActions)
    {
        treeActions.Add(new RepositoryObjectActionModel(
            "Add",
            Items:
            [
                new RepositoryObjectActionModel(
                    "Add file",
                    Href: Url.Page("/Repos/Edit", "New", new { repoName = Model.RepoName, parentPath = Model.Path, isDirectory = false })),
                new RepositoryObjectActionModel(
                    "Add folder",
                    Href: Url.Page("/Repos/Edit", "New", new { repoName = Model.RepoName, parentPath = Model.Path, isDirectory = true })),
                new RepositoryObjectActionModel("-"),
                new RepositoryObjectActionModel("Upload files...", UploadOpenTarget: "files"),
                new RepositoryObjectActionModel("Upload folder...", UploadOpenTarget: "folder"),
            ]));
    }

    if (Model.CanWriteActions && Model.Path != "/")
    {
        treeActions.Add(new RepositoryObjectActionModel(
            "Edit",
            Href: Url.Page("/Repos/Edit", null, new { repoName = Model.RepoName, path = Model.Path })));
    }

    treeActions.Add(new RepositoryObjectActionModel(
        "History",
        Href: Url.Page("/Repos/History", null, new { repoName = Model.RepoName, path = Model.Path == "/" ? null : Model.Path, rev = Model.ViewRevision })));
    treeActions.Add(new RepositoryObjectActionModel(
        "Download ZIP",
        Href: Url.Page("/Repos/Tree", "Zip", new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.Path), rev = Model.ViewRevision })));

    if (!string.IsNullOrWhiteSpace(tortoiseCheckoutUrl))
    {
        treeActions.Add(new RepositoryObjectActionModel("Checkout", Href: tortoiseCheckoutUrl));
    }

    if (!string.IsNullOrWhiteSpace(checkoutUrl))
    {
        treeActions.Add(new RepositoryObjectActionModel("Copy SVN URL", CopyText: checkoutUrl, CopyMessageTarget: "#treeCopyMsg"));
    }

    var readmeActions = new List<RepositoryObjectActionModel>();
    if (Model.CanEditReadme)
    {
        readmeActions.Add(new RepositoryObjectActionModel(
            "Edit",
            Href: Url.Page("/Repos/Edit", null, new { repoName = Model.RepoName, path = Model.ReadmePath })));
    }

    readmeActions.Add(new RepositoryObjectActionModel(
        "Open",
        Href: Url.Page("/Repos/File", null, new { repoName = Model.RepoName, path = RepositoryPath.ToRouteValue(Model.ReadmePath), rev = Model.ViewRevision })));
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h1 class="mb-0">@Model.RepoName</h1>
    @if (Model.CanOpenSettings)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Repos/Settings" asp-route-repoName="@Model.RepoName">Settings</a>
    }
</div>
<div class="text-muted">r@(Model.Revision)</div>

@await Html.PartialAsync("Shared/_RepositoryBreadcrumb", new SvnHub.Web.Support.RepositoryBreadcrumbModel(Model.RepoName, Model.Path, Model.ViewRevision))

@if (Model.ViewRevision is not null && Model.Revision != Model.HeadRevision)
{
    @await Html.PartialAsync("Shared/_RepositoryRevisionNotice", new RepositoryRevisionNoticeModel(Model.RepoName, Model.Revision, Model.HeadRevision))
}

@section Head
{
    @if (Model.HasReadme)
    {
        <link rel="stylesheet" href="~/css/markdown.css" asp-append-version="true" />
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success mt-3">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.FlashError))
{
    <div class="alert alert-danger mt-3">@Model.FlashError</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}
else
{
    <div class="repo-object-layout mt-3 @(Model.Labels.Count > 0 ? "has-context" : "")">
        <div class="repo-object-main">
            @await Html.PartialAsync("Shared/_RepositoryObjectCard", new RepositoryObjectCardModel(
                new RepositoryObjectTitleModel(Model.Path, IsDirectory: true, treeTitleMetadata),
                treeActions,
                "Shared/_RepositoryTreeCardBody",
                Model,
                WrapBodyInCardBody: false,
                CopyMessageElementId: "treeCopyMsg"))

            @await Html.PartialAsync("Shared/_RepositoryUploadModal", Model)
            @await Html.PartialAsync("Shared/_RepositoryDeleteModal")

            @if (Model.HasReadme)
            {
                <div class="mt-3">
                    @await Html.PartialAsync("Shared/_RepositoryObjectCard", new RepositoryObjectCardModel(
                        new FilePreviewTitleModel(Model.ReadmePath).ToRepositoryObjectTitle(),
                        readmeActions,
                        "Shared/_RepositoryMarkdownBody",
                        Model.ReadmeHtml,
                        WrapBodyInCardBody: true))
                </div>
            }
        </div>
        @await Html.PartialAsync("Shared/_RepositoryContextSidebar", new RepositoryContextSidebarModel(Model.Labels))
    </div>
}

@section Scripts
{
    @if (Model.CanWriteActions)
    {
        <script src="~/js/repository-tree.js" asp-append-version="true"></script>
        <script src="~/js/repository-delete.js" asp-append-version="true"></script>
    }
}
