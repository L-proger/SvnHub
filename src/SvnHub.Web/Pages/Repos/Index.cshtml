@page
@model SvnHub.Web.Pages.Repos.IndexModel
@inject SvnHub.Web.Support.MaterialFileIconService FileIcons
@using SvnHub.App.Support
@{
    ViewData["Title"] = "Repositories";
}

<div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
    <h1 class="mb-0">Repositories</h1>
    @if ((User?.IsInRole("admin.system") ?? false) || (User?.IsInRole("repo.create") ?? false))
    {
        <div class="d-flex gap-2 ms-auto">
            @if (User?.IsInRole("admin.system") ?? false)
            {
                <form method="post" asp-page-handler="Discover" class="d-inline">
                    <input type="hidden" name="p" value="@Model.PageNumber" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <input type="hidden" name="q" value="@Model.SearchQuery" />
                    <input type="hidden" name="label" value="@Model.LabelFilter" />
                    <button class="btn btn-outline-secondary" type="submit">Discover</button>
                </form>
            }
            @if (User?.IsInRole("repo.create") ?? false)
            {
                <a class="btn btn-primary" asp-page="/Repos/Create">Create</a>
            }
        </div>
    }
</div>

<div class="mt-3">
    <form method="get" class="repo-filterbar">
        <div class="repo-filterbar-search">
            <input type="search"
                   name="q"
                   value="@Model.SearchQuery"
                   class="form-control form-control-sm"
                   placeholder="Search repositories"
                   oninput="this.form.p.value = 1;" />
            <button class="btn btn-sm btn-outline-secondary" type="submit" title="Search" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242 1.156a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                </svg>
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.LabelFilter))
            {
                <a class="btn btn-sm btn-outline-secondary"
                   asp-page="/Repos/Index"
                   asp-route-pageSize="@Model.PageSize">Clear</a>
            }
        </div>
        <div class="repo-filterbar-controls">
            @if (Model.LabelOptions.Count > 0)
            {
                <label class="text-muted small" for="labelFilter">Label</label>
                <select id="labelFilter" name="label" class="form-select form-select-sm sp-auto-width"
                        onchange="this.form.p.value = 1; this.form.submit();">
                    <option value="">All</option>
                    @foreach (var label in Model.LabelOptions)
                    {
                        <option value="@label" selected="@(string.Equals(Model.LabelFilter, label, StringComparison.OrdinalIgnoreCase))">@label</option>
                    }
                </select>
            }

            <label class="text-muted small" for="pageSize">Per page</label>
            <select id="pageSize" name="pageSize" class="form-select form-select-sm sp-auto-width"
                    onchange="this.form.p.value = 1; this.form.submit();">
                @foreach (var pageSize in Model.PageSizeOptions)
                {
                    <option value="@pageSize" selected="@(Model.PageSize == pageSize)">@pageSize</option>
                }
            </select>
        </div>
        <input type="hidden" name="p" value="@Model.PageNumber" />
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info mt-3">@Model.Message</div>
}

@if (Model.TotalCount > 0)
{
    <div class="text-muted small mt-3">
        Showing @Model.FromIndex-@Model.ToIndex of @Model.TotalCount
    </div>
}

<div class="list-group list-group-flush sp-list repo-list mt-3">
    @foreach (var r in Model.Repositories)
    {
        var updatedAt = Model.UpdatedAtByRepoName.TryGetValue(r.Name, out var dt) ? dt : null;
        var updatedLabel = updatedAt is null
            ? "Updated \u2014"
            : $"Updated {SvnHub.Web.Pages.Repos.IndexModel.FormatUpdatedAgo(updatedAt.Value, DateTimeOffset.UtcNow)}";
        var repositoryIconHref = FileIcons.GetRepositoryIconHref();
        var labels = RepositoryLabels.Normalize(r.Labels);
        var canBrowse = Model.BrowseableRepositoryIds.Contains(r.Id);

        <div class="list-group-item">
            <div class="d-flex align-items-start justify-content-between gap-3">
                <div class="d-flex align-items-start gap-3">
                    @if (!string.IsNullOrWhiteSpace(repositoryIconHref))
                    {
                        <img class="sp-icon repo-icon sp-file-icon" src="@Url.Content(repositoryIconHref)" alt="" aria-hidden="true" />
                    }
                    else
                    {
                        <svg class="sp-icon repo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M3.75 1A2.75 2.75 0 0 0 1 3.75v10.5c0 .414.336.75.75.75h10.5A2.75 2.75 0 0 0 15 12.25V2.75A1.75 1.75 0 0 0 13.25 1Zm0 1.5h9.5c.138 0 .25.112.25.25v9.5c0 .69-.56 1.25-1.25 1.25H2.5v-.25c0-.69.56-1.25 1.25-1.25h7.5a.75.75 0 0 0 .75-.75V4.75a.75.75 0 0 0-.75-.75h-7.5a1.25 1.25 0 1 1 0-2.5Zm0 4h6.75v4H3.75c-.45 0-.878.108-1.25.3V5.68c.373.204.8.32 1.25.32Z"/>
                        </svg>
                    }
                    <div class="flex-grow-1">
                        @if (canBrowse)
                        {
                            <a asp-page="/Repos/Tree"
                               asp-route-repoName="@r.Name"
                               asp-route-defaultPath="true"
                               class="repo-name link-primary link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover">
                                @r.Name
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Repos/Settings"
                               asp-route-repoName="@r.Name"
                               class="repo-name link-primary link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover">
                                @r.Name
                            </a>
                            <span class="badge text-bg-secondary ms-2">settings only</span>
                        }
                        <div class="repo-updated text-muted small" title="@(updatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz"))">
                            @updatedLabel
                        </div>
                        @if (labels.Count > 0)
                        {
                            <div class="repo-labels d-flex flex-wrap gap-1 mt-1">
                                @foreach (var label in labels)
                                {
                                    <a class="badge rounded-pill text-bg-secondary text-decoration-none"
                                       asp-page="/Repos/Index"
                                       asp-route-label="@label"
                                       asp-route-pageSize="@Model.PageSize">@label</a>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SvnBaseUrl))
                {
                    <div class="sp-row-actions dropdown">
                        <button class="btn btn-sm btn-outline-secondary sp-icon-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-label="Actions">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                            </svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        data-copy-text="@Model.GetCheckoutUrl(r.Name)">
                                    Copy SVN URL
                                </button>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Repos pagination">
        <ul class="pagination justify-content-center mt-4">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Repos/Index"
                   asp-route-p="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-label="@Model.LabelFilter">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Repos/Index"
                   asp-route-p="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-label="@Model.LabelFilter">Next</a>
            </li>
        </ul>
    </nav>
}
