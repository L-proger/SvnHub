@page "/account"
@using SvnHub.Domain
@model SvnHub.Web.Pages.AccountModel
@{
    ViewData["Title"] = "Account";
}

@if (Model.CurrentUser is null)
{
    <div class="alert alert-danger">Account not found.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="mb-0">@Model.CurrentUser.UserName</h1>
        <div class="text-muted small">Account</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Success))
{
    <div class="alert alert-success mt-3">@Model.Success</div>
}

@if (!string.IsNullOrWhiteSpace(Model.CreatedToken))
{
    <div class="alert alert-warning mt-3">
        <div class="fw-semibold mb-2">Copy this token now. It will not be shown again.</div>
        <div class="input-group">
            <input class="form-control font-monospace" value="@Model.CreatedToken" readonly id="createdToken" />
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-copy-from="#createdToken"
                    data-copy-msg="#createdTokenCopyMsg">
                Copy
            </button>
        </div>
        <div class="text-muted small mt-2" id="createdTokenCopyMsg"></div>
    </div>
}

<hr class="mt-4" />

<h2>Profile</h2>
<div class="table-responsive mt-2">
    <table class="table table-sm align-middle">
        <tbody>
        <tr>
            <th scope="row" class="account-profile-label">User name</th>
            <td>@Model.CurrentUser.UserName</td>
        </tr>
        <tr>
            <th scope="row">Roles</th>
            <td>@Model.RolesLabel</td>
        </tr>
        <tr>
            <th scope="row">Theme</th>
            <td>@Model.ThemeLabel</td>
        </tr>
        <tr>
            <th scope="row">Created</th>
            <td>@Model.CurrentUser.CreatedAt.ToString("u")</td>
        </tr>
        <tr>
            <th scope="row">Status</th>
            <td>
                @if (Model.CurrentUser.IsActive)
                {
                    <span class="badge text-bg-success">Active</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Inactive</span>
                }
            </td>
        </tr>
        </tbody>
    </table>
</div>

<hr class="mt-4" />

<h2>Appearance</h2>
<form method="post" asp-page-handler="ChangeTheme" class="mt-3" autocomplete="off">
    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label" for="theme">Theme</label>
            <select id="theme" name="theme" class="form-select">
                <option value="System" selected="@(Model.CurrentUser.Theme == PortalUserTheme.System ? "selected" : null)">System</option>
                <option value="Dark" selected="@(Model.CurrentUser.Theme == PortalUserTheme.Dark ? "selected" : null)">Dark</option>
                <option value="Light" selected="@(Model.CurrentUser.Theme == PortalUserTheme.Light ? "selected" : null)">Light</option>
            </select>
        </div>
        <div class="col-md-7 mb-3"></div>
        <div class="col-md-2 mb-3 d-flex align-items-end justify-content-md-end">
            <button class="btn btn-primary w-100" type="submit">Update</button>
        </div>
    </div>
</form>

<hr class="mt-4" />

<h2>Change Password</h2>
<form method="post" asp-page-handler="ChangePassword" class="mt-3" autocomplete="off">
    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="PasswordInput.CurrentPassword" class="form-label"></label>
            <input asp-for="PasswordInput.CurrentPassword"
                   type="password"
                   class="form-control"
                   autocomplete="current-password" />
            <span asp-validation-for="PasswordInput.CurrentPassword" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PasswordInput.NewPassword" class="form-label"></label>
            <input asp-for="PasswordInput.NewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="PasswordInput.NewPassword" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PasswordInput.ConfirmNewPassword" class="form-label"></label>
            <input asp-for="PasswordInput.ConfirmNewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="PasswordInput.ConfirmNewPassword" class="text-danger"></span>
        </div>
        <div class="col-md-1 mb-3"></div>
        <div class="col-md-2 mb-3 d-flex align-items-end justify-content-md-end">
            <button class="btn btn-primary w-100" type="submit">Update</button>
        </div>
    </div>
</form>

<hr class="mt-4" />

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h2 class="mb-0">Application Tokens</h2>
</div>

<form method="post" asp-page-handler="CreateToken" class="mt-3" autocomplete="off">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="TokenInput.Name" class="form-label"></label>
            <input asp-for="TokenInput.Name" class="form-control" placeholder="Automation script" />
            <span asp-validation-for="TokenInput.Name" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="TokenInput.ExpiresInDays" class="form-label"></label>
            <select asp-for="TokenInput.ExpiresInDays" class="form-select">
                <option value="90">90 days</option>
                <option value="30">30 days</option>
                <option value="365">1 year</option>
                <option value="never">Never</option>
            </select>
            <span asp-validation-for="TokenInput.ExpiresInDays" class="text-danger"></span>
        </div>
        <div class="col-md-1 mb-3"></div>
        <div class="col-md-2 mb-3 d-flex align-items-end justify-content-md-end">
            <button class="btn btn-primary w-100" type="submit">Create</button>
        </div>
    </div>
</form>

@if (Model.Tokens.Count == 0)
{
    <div class="text-muted mt-2">No application tokens yet.</div>
}
else
{
    <div class="table-responsive mt-3">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>Name</th>
                <th>Token</th>
                <th>Status</th>
                <th>Created</th>
                <th>Last used</th>
                <th>Expires</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var token in Model.Tokens)
            {
                var status = AccountModel.FormatTokenStatus(token);
                <tr>
                    <td>@token.Name</td>
                    <td><code>@token.TokenPrefix...</code></td>
                    <td>
                        @if (status == "Active")
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else if (status == "Expired")
                        {
                            <span class="badge text-bg-secondary">Expired</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Revoked</span>
                        }
                    </td>
                    <td>@token.CreatedAt.ToString("u")</td>
                    <td>@(token.LastUsedAt?.ToString("u") ?? "Never")</td>
                    <td>@(token.ExpiresAt?.ToString("u") ?? "Never")</td>
                    <td class="text-end">
                        @if (token.RevokedAt is null)
                        {
                            <form method="post" asp-page-handler="RevokeToken" class="d-inline">
                                <input type="hidden" name="tokenId" value="@token.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Revoke this application token?');">
                                    Revoke
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
