# Host paths (bind mounts)
SVNHUB_DATA=/srv/svnhub/data
SVNHUB_REPOS=/srv/svnhub/repos

# Service identity inside the container. Linux bind mounts use numeric IDs.
# For existing repositories, set these to the host owner/group of your repo tree:
#   stat -c '%u:%g %n' /path/to/existing/repos
SVNHUB_UID=10001
SVNHUB_GID=10001

# Optional: recursively chown both mounted directories at startup.
# Leave disabled for existing production repositories unless you intentionally want this.
SVNHUB_FIX_OWNERSHIP=0

# Max file size SvnHub will load for browser preview/raw/download responses.
# Larger files stay accessible through SVN checkout, but are not read into the UI process.
SVNHUB_MAX_PREVIEW_BYTES=52428800

# Optional exact origin for a browser-based MCP client hosted outside localhost.
# Loopback origins such as http://127.0.0.1:1235 are allowed automatically.
SVNHUB_MCP_ALLOWED_ORIGIN=
